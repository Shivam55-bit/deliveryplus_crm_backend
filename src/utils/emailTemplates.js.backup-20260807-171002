const getCanonicalCalloutMinutes = (job = {}, rawPricing = {}) => {
  if (hasValue(rawPricing.calloutTimeMinutes)) {
    return Math.max(
      0,
      toNumber(rawPricing.calloutTimeMinutes),
    );
  }

  if (hasValue(job.calloutTimeMinutes)) {
    return Math.max(
      0,
      toNumber(job.calloutTimeMinutes),
    );
  }

  return Math.max(
    0,
    toNumber(job.callOutTimeHr) * 60 +
    toNumber(job.callOutTimeMin),
  );
};

const getCanonicalTravelBackMinutes = (job = {}, rawPricing = {}) => {
  if (hasValue(rawPricing.travelBackTimeMinutes)) {
    return Math.max(
      0,
      toNumber(rawPricing.travelBackTimeMinutes),
    );
  }

  if (hasValue(job.travelBackTimeMinutes)) {
    return Math.max(
      0,
      toNumber(job.travelBackTimeMinutes),
    );
  }

  return Math.max(
    0,
    toNumber(job.travelBackTimeHr) * 60 +
    toNumber(job.travelBackTimeMin),
  );
};

const getPricingObject = (job = {}) => {
  const rawPricing =
    job.pricing ??
    job.pricingSnapshot ??
    {};

  const hourlyRate = toNumber(firstValue(
    rawPricing.hourlyRate,
    job.hourlyRate,
    job.price,
    job.rate,
  ));

  const minimumChargeHours = toNumber(firstValue(
    rawPricing.minimumChargeHours,
    job.minimumChargeHours,
    job.minimumHours,
    job.minimumDuration,
    job.estimatedHours,
    2.5,
  ), 2.5);

  const calloutTimeMinutes =
    getCanonicalCalloutMinutes(job, rawPricing);

  const travelBackTimeMinutes =
    getCanonicalTravelBackMinutes(job, rawPricing);

  const calculatedMinimumLaborCost =
    roundMoney(hourlyRate * minimumChargeHours);

  const storedMinimumLaborCost = toNumber(firstValue(
    rawPricing.minimumLaborCost,
    job.minimumLaborCost,
    job.minimumCost,
  ));

  const minimumLaborCost =
    storedMinimumLaborCost > 0
      ? storedMinimumLaborCost
      : calculatedMinimumLaborCost;

  const storedCalloutCharge = toNumber(firstValue(
    rawPricing.calloutCharge,
    job.calloutCharge,
    job.callOutFee,
    job.calloutFee,
    job.callOutCharge,
  ));

  const calculatedCalloutCharge = roundMoney(
    (hourlyRate / 60) *
    calloutTimeMinutes,
  );

  const calloutCharge =
    calloutTimeMinutes > 0 &&
    hourlyRate > 0 &&
    storedCalloutCharge <= 0
      ? calculatedCalloutCharge
      : storedCalloutCharge;

  const storedTravelBackCharge = toNumber(firstValue(
    rawPricing.travelBackCharge,
    job.travelBackCharge,
    job.travelBackFee,
    job.returnTravelCharge,
  ));

  const calculatedTravelBackCharge = roundMoney(
    (hourlyRate / 60) *
    travelBackTimeMinutes,
  );

  const travelBackCharge =
    travelBackTimeMinutes > 0 &&
    hourlyRate > 0 &&
    storedTravelBackCharge <= 0
      ? calculatedTravelBackCharge
      : storedTravelBackCharge;

  const calculatedMinimumEstimatedCost = roundMoney(
    minimumLaborCost +
    calloutCharge +
    travelBackCharge,
  );

  const storedMinimumEstimatedCost = toNumber(firstValue(
    rawPricing.minimumEstimatedCost,
    job.minimumEstimatedCost,
    job.estimatedCost,
  ));

  const minimumEstimatedCost =
    storedMinimumEstimatedCost > 0
      ? storedMinimumEstimatedCost
      : calculatedMinimumEstimatedCost;

  return {
    hourlyRate,
    minimumChargeHours,
    minimumChargeMinutes:
      Math.round(minimumChargeHours * 60),

    minimumLaborCost,

    calloutCharge,
    calloutTimeMinutes,

    travelBackCharge,
    travelBackTimeMinutes,

    minimumEstimatedCost,

    extraTimeBlockMinutes:
      rawPricing.extraTimeBlockMinutes ?? 30,

    extraTimeRatePerBlock:
      rawPricing.extraTimeRatePerBlock,

    extraTimeCharge:
      toNumber(rawPricing.extraTimeCharge),

    finalTotal: toNumber(firstValue(
      rawPricing.finalTotal,
      job.finalTotal,
      job.totalAmount,
      job.billing?.totalAmount,
    )),
  };
};

const buildQuotationEmailData = (job = {}) => {
  const pricing = getPricingObject(job);

  const jobReference = firstValue(
    job.jobNumber,
    job.quoteRef,
    job.jobReference,
    job.referenceNumber,
  );

  const normalizedJobType = String(firstValue(
    job.jobType,
    job.type,
    job.category,
    '',
  ) || '')
    .trim()
    .toLowerCase();

  const customerName = firstValue(
    job.customerName,
    job.customer?.name,
    job.name,
    'Customer',
  );

  const customerEmail = firstValue(
    job.customerEmail,
    job.customer?.email,
    job.email,
    '',
  );

  const customerPhone = firstValue(
    job.customerPhone,
    job.customer?.phone,
    job.phone,
    '',
  );

  const scheduleMode = String(firstValue(
    job.scheduleMode,
    job.scheduledTimeMode,
    job.scheduleType,
    '',
  ) || '')
    .trim()
    .toLowerCase();

  const scheduledDate = firstValue(
    job.scheduledDate,
    job.scheduledAt,
    job.date,
  ) || '';

  const scheduledTime =
    scheduleMode === 'window'
      ? `${formatTime(firstValue(
          job.scheduledStartTime,
          job.startTime,
          job.scheduledFrom,
        ))} - ${formatTime(firstValue(
          job.scheduledEndTime,
          job.endTime,
          job.scheduledTo,
        ))}`
      : formatTime(firstValue(
          job.scheduledTime,
          job.time,
          job.scheduledAtTime,
        ));

  const rawTruckSize = firstValue(
    job.truckSize,
    job.vehicleSize,
    job.truckType,
    job.truckSizeCount,
  );

  const fixedPrice = toNumber(firstValue(
    job.fixedPrice,
    job.fixedQuote,
    job.quoteAmount,
    job.pricing?.fixedPrice,
  ));

  const notes = [
    firstValue(job.notes, ''),
    firstValue(job.specialInstructions, ''),
  ]
    .map((value) => String(value || '').trim())
    .filter(Boolean)
    .join('\n\n');

  return {
    jobReference,
    jobType: normalizedJobType,
    isMovingJob: normalizedJobType === 'moving',

    customerName,
    customerEmail,
    customerPhone,

    pickupAddress:
      getCanonicalPickupAddress(job),

    dropAddress:
      getCanonicalDropAddress(job),

    scheduledDate,
    scheduledTime,

    propertySize:
      firstValue(
        job.propertySize,
        job.sizeOfProperty,
        job.bedrooms,
        job.houseSize,
        job.moveSize,
        job.size,
      ) || '',

    itemList:
      formatItemList(job),

    pricingType:
      String(firstValue(
        job.pricingType,
        job.pricing?.type,
        '',
      ) || '').toLowerCase(),

    hourlyRate:
      pricing.hourlyRate,

    fixedPrice,

    truckSize:
      formatTruckSize(rawTruckSize),

    movers:
      firstValue(
        job.movers,
        job.numberOfMovers,
        job.moverCount,
      ),

    minimumHours:
      pricing.minimumChargeHours,

    minimumLaborCost:
      pricing.minimumLaborCost,

    minimumEstimatedCost:
      pricing.minimumEstimatedCost,

    calloutCharge:
      pricing.calloutCharge,

    calloutTimeMinutes:
      pricing.calloutTimeMinutes,

    travelBackCharge:
      pricing.travelBackCharge,

    travelBackTimeMinutes:
      pricing.travelBackTimeMinutes,

    depositAmount:
      getBookingDepositValue(job),

    notes,

    pricing,
  };
};

